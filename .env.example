# QuotePal env — copy to .env (never commit .env)
PORT=8790
PAYPAL_ENV=mock
# For real sandbox: set PAYPAL_ENV=sandbox and fill these from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
MERCHANT_EMAIL=merchant@example.com
# Optional LLM (any OpenAI-compatible). Without it, offline heuristic parse + reminder templates run.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
